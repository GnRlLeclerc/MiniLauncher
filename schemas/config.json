{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GnRlLeclerc/MiniLauncher/blob/master/schemas/config.json",
  "title": "Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "animation_duration": {
      "type": "integer",
      "description": "Animation duration in milliseconds"
    },
    "border_width": {
      "type": "integer",
      "description": "Border thickness in pixels"
    },
    "border_radius": {
      "type": "integer",
      "description": "Border radius in pixels"
    },
    "mode": {
      "type": "string",
      "description": "Display layout",
      "enum": ["full", "compact", "lines", "icons"]
    },
    "max_entries": {
      "type": "integer",
      "description": "Maximum number of entries to display"
    }
  }
}

import { VerticalBox, LineEdit } from "std-widgets.slint";
import { LauncherState, LauncherColors } from "state.slint";
import { LauncherInput } from "input.slint";

// Re-export global singletons to make them accessible from rust
export { LauncherState, LauncherColors } from "state.slint";


component Option inherits Rectangle {
    in property <string> name;
    in property <int> index;

    width: 100%;
    height: 40px;
    border-radius: 8px;

    background: touch.pressed ? LauncherColors.accent : (index == LauncherState.selected_index) ? LauncherColors.highlight.transparentize(90%) : LauncherColors.background;

    animate background { duration: 100ms; }

    Text {
        width: parent.width - 20px;
        horizontal-alignment: TextHorizontalAlignment.left;
        text: name;
        color: LauncherColors.text;
    }

    touch := TouchArea {
        changed has-hover => {
            if self.has-hover {
                LauncherState.selected_index = index;
            }
        }

        clicked => LauncherState.run_command(name);
    }
}

component Divider inherits Rectangle {
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: LauncherColors.border;
}

export component Launcher inherits Window {
    title: "MiniLauncher";
    background: LauncherColors.background;
    VerticalBox {
        LauncherInput { }

        Divider { }

        for entry[index] in LauncherState.entries: Option {
            name: entry.name;
            index: index;
        }
    }
}

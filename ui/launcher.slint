import { VerticalBox, LineEdit } from "std-widgets.slint";

// Entry displayed in the menu
export struct LauncherEntry {
    name: string,
    icon: string, // "" if no icon
    description: string,
}

// Global app state
export global LauncherState {
    in-out property <[LauncherEntry]> entries;
    in-out property <int> selected_index: 0;
    callback update_entries(input: string);
    callback run_command(name: string);
}

component Option inherits Rectangle {
    in property <string> name;
    in property <int> index: -1;

    width: 100%;
    height: 50px;
    border-radius: 8px;

    background: touch.pressed ? #6b8282 : (index == LauncherState.selected_index) ? #6c616c : #456;

    animate background { duration: 100ms; }

    Text {
        text: name;
    }

    touch := TouchArea {
        changed has-hover => {
            if self.has-hover {
                LauncherState.selected_index = index;
            }
        }

        clicked => LauncherState.run_command(name);
    }
}

component Divider inherits Rectangle {
    width: 100%;
    height: 1px;
    background: #888;
}

export component Launcher inherits Window {
    init => {
        input.focus();
    }

    title: "MiniLauncher";
    VerticalBox {
        input := LineEdit {
            placeholder-text: "Enter an app name...";
            height: 50px;
            edited(input) => {
                LauncherState.update_entries(input);

                // Adjust selected index if out of bounds
                if LauncherState.entries.length == 0 {
                    LauncherState.selected_index = 0;
                } else if LauncherState.selected_index >= LauncherState.entries.length {
                    LauncherState.selected_index = LauncherState.entries.length - 1;
                }
            }
            accepted(_) => {
                if LauncherState.entries.length > 0 {
                    let selected_entry = LauncherState.entries[LauncherState.selected_index];
                    LauncherState.run_command(selected_entry.name);
                }
            }
        }

        Divider { }

        for entry[index] in LauncherState.entries: Option {
            name: entry.name;
            index: index;
        }
    }
}
